title: Upgrade_The_Seagull_Inn
position: -354,-66
---
<<if $The_Seagull_CurrentLv > 0 && $The_Seagull_CurrentLv < 3>>
    <<if $The_Seagull_CurrentLv == 1>>
        Bruno : 2,000 coins.
        -> Here you are.
            <<set $upgradeOk = false>>
            <<canTryUpgrade "TheSeagullInn">>
            <<set $upgradeOk = canUpgradeSuccess()>>
            <<if $upgradeOk>>
                <<set $The_Seagull_CurrentLv += 1>>
                <<jump Admited_Upgrade>>
            <<else>>
                Bruno : Sorry, I can't upgrade this building right now. Maybe it's already being worked on.
                -> Back to select building.
                    <<jump Select_Building_to_Upgrade>>
                -> Ok then.
                    <<jump Cancel_Upgrade>>
            <<endif>>
        -> I'll cancel it.
            <<jump Cancel_Upgrade>>
    <<endif>>
    <<if $The_Seagull_CurrentLv == 2>>
        Bruno : 3,000 coins.
        -> Here you are.
            <<set $upgradeOk = false>>
            <<canTryUpgrade "TheSeagullInn">>
            <<set $upgradeOk = canUpgradeSuccess()>>
            <<if $upgradeOk>>
                <<set $The_Seagull_CurrentLv += 1>>
                <<jump Admited_Upgrade>>
            <<else>>
                Bruno : Sorry, I can't upgrade this building right now. Maybe it's already being worked on.
                -> Back to select building.
                    <<jump Select_Building_to_Upgrade>>
                -> Ok then.
                    <<jump Cancel_Upgrade>>
            <<endif>>
        -> I'll cancel it.
            <<jump Cancel_Upgrade>>
    <<endif>>
<<else>>
    <<set $The_Seagull_CurrentLv = -1>>
    Bruno : Now you can't upgrade this building anymore.
    -> Back to select building.
        <<jump Select_Building_to_Upgrade>>
    -> Ok then.
<<endif>>
===

